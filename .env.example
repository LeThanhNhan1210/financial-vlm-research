# ==============================================================================
# FINANCIAL VLM RESEARCH - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Hướng dẫn: 
# 1. Tạo bản sao của file này và đổi tên thành '.env'
# 2. Điền các khóa API và đường dẫn phù hợp với môi trường của bạn
# 3. File '.env' đã được chặn trong '.gitignore' để đảm bảo an toàn tuyệt đối
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Keys (Sinh dữ liệu nhãn CoT & Chấm điểm LLM-as-a-Judge)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 2. Hugging Face Hub (Tải mô hình Qwen-VL / Llama-Vision và lưu Adapter)
# ------------------------------------------------------------------------------
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ------------------------------------------------------------------------------
# 3. Weights & Biases (Theo dõi Loss, GPU VRAM & Thực nghiệm huấn luyện)
# ------------------------------------------------------------------------------
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=financial-vlm-research
WANDB_ENTITY=your_wandb_username_or_team

# ------------------------------------------------------------------------------
# 4. Cấu hình Môi trường Google Colab & Google Drive
# ------------------------------------------------------------------------------
COLAB_MOUNT_DRIVE=true
DRIVE_PROJECT_ROOT=/content/drive/MyDrive/NCKH_AI
DRIVE_CHECKPOINTS_DIR=/content/drive/MyDrive/NCKH_AI/2_checkpoints
DRIVE_DATASETS_DIR=/content/drive/MyDrive/NCKH_AI/1_datasets

# ------------------------------------------------------------------------------
# 5. Thiết lập PyTorch & CUDA trên GPU T4 (16GB VRAM)
# ------------------------------------------------------------------------------
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
TOKENIZERS_PARALLELISM=false
